# --- Supabase (content, Google sign-in, admin dashboard) -------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional. The browser uses its own origin; this is only a server-side fallback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true only after enabling Google under Authentication → Providers in
# Supabase (needs a Google OAuth client id and secret). Off by default.
# Google sign-in ships on. Set to "false" to hide the button.
NEXT_PUBLIC_GOOGLE_SIGNIN=false

# --- Ask-the-Troop chatbot (optional; falls back to offline answers) -------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# Chatbot rate limits (per IP)
CHAT_LIMIT_PER_MINUTE=6
CHAT_LIMIT_PER_DAY=60

# --- Outbound mail (contact form) -----------------------------------------
# Two ways to send; the first one configured wins. With neither, the contact
# form falls back to opening the visitor's own mail client, so the page still
# works with no keys set.
#
# 1. GMAIL (default). The troop's own account, over SMTP.
#    GMAIL_APP_PASSWORD is a Google *app password*, not the account password:
#      · turn on 2-Step Verification for the account
#      · https://myaccount.google.com/apppasswords → create one, name it
#        something like "Troop website"
#      · paste the 16 characters here; spaces are fine, they get stripped
#    Revoking it on that page instantly cuts the site off, which is the point.
#    Verify it with:  npm run check:email
GMAIL_USER=troop394sc@gmail.com
GMAIL_APP_PASSWORD=

# 2. RESEND. Only if the troop moves to its own domain and wants a real
#    sending service. Ignored while the Gmail pair above is filled in.
RESEND_API_KEY=

# Optional display name/address on outgoing mail. Gmail rewrites the address to
# the authenticated account whatever you put here, so this really only changes
# the name a recipient sees. Leave blank for "Troop 2/394 website <the account>".
CONTACT_FROM=

# reCAPTCHA v3 on the contact form. Both or neither; with neither, the
# honeypot and the rate limit still apply.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
