# --- Supabase (content, Google sign-in, admin dashboard) -------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true only after enabling Google under Authentication → Providers in
# Supabase (needs a Google OAuth client id and secret). Off by default.
NEXT_PUBLIC_GOOGLE_SIGNIN=false

# --- Ask-the-Troop chatbot (optional; falls back to offline answers) -------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# Chatbot rate limits (per IP)
CHAT_LIMIT_PER_MINUTE=6
CHAT_LIMIT_PER_DAY=60
